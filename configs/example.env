# 启动时会自动读取 configs/.env（可用 ENV_FILE 指定其它路径）
# 决策：MODEL=mock 不需要 JEV；MODEL=jev 必须设置 TYPESAFE_API_KEY

# Style A — mock dry-run（不调 JEV API）
EXCHANGE=mock
DRY_RUN=true
MODEL=mock
SYMBOL=BTC
TICK_INTERVAL=2s
ORDER_SIZE_BTC=0.001
MAX_POSITION_BTC=0.003
QUOTE_INSIDE_TICKS=1
HTTP_LISTEN=127.0.0.1:8080
DATA_DIR=data

# JEV（把上面 MODEL 改成 jev，并取消下面注释）
# MODEL=jev
# 多个 Key 逗号或换行分隔；lighter/mock 默认用第 1 个，vanta 默认用第 2 个（可设 TYPESAFE_KEY_INDEX 覆盖）
# TYPESAFE_API_KEYS=key_for_lighter,key_for_vanta,key_spare
# TYPESAFE_API_KEY=单 key 时仍可用（会并入列表）
# JEV_MODEL_ID=jev-1.13.0

# Lighter RB — real book, simulated orders (DRY_RUN=true)
# 文档: https://apidocs.rh.lighter.xyz/docs/get-started  主网 Chain ID 466324
# DRY_RUN=true 时只拉盘口，不会 init 签名器、也不会调 /api/v1/apikeys
# EXCHANGE=lighter
# LIGHTER_HOST=https://api.rh.lighter.xyz
# LIGHTER_CHAIN_ID=466324
# LIGHTER_ACCOUNT_INDEX=123
# LIGHTER_API_KEY_INDEX=2
# LIGHTER_API_PRIVATE_KEY=

# Lighter 双账户：JEV buy → A 挂多，JEV sell → B 挂空（共享公开订单簿 + 同一 JEV）
# LIGHTER_DUAL=true
# LIGHTER_ACCOUNT_A_INDEX=123
# LIGHTER_ACCOUNT_B_INDEX=456
# LIGHTER_A_API_PRIVATE_KEY=   # 可省略，回退 LIGHTER_API_PRIVATE_KEY
# LIGHTER_B_API_PRIVATE_KEY=
# LIGHTER_A_API_KEY_INDEX=2
# LIGHTER_B_API_KEY_INDEX=2
# 双满 A 多 + B 空 → UNWIND 反向 reduce-only，双零后回到 JEV 正循环
# LIGHTER_DUAL_UNWIND=true
# UNWIND_ENTER_CONFIRM_TICKS=2
# UNWIND_EXIT_CONFIRM_TICKS=2
# UNWIND_FLAT_EPS=0.000001

# Vanta（Orderly）— https://vanta-6.gitbook.io/vanta-gitbook/core-concepts/api
# EXCHANGE=vanta
# VANTA_BASE_URL=https://api.orderly.org
# VANTA_SYMBOL=PERP_BTC_USDC
# VANTA_ORDERLY_ACCOUNT_ID=
# VANTA_ORDERLY_KEY=ed25519:...
# VANTA_ORDERLY_SECRET=ed25519:...

# Live (requires signer implementation — see README)
# DRY_RUN=false
# 杠杆：Live 启动时对 BTC 市场发一笔 updateLeverage（DRY_RUN 不生效）
# LIGHTER_LEVERAGE=5          # 1–100；0 或不设且 LEVERAGE 未设 = 不自动改杠杆（也可用旧名 LEVERAGE=5）
# LIGHTER_LEVERAGE_CROSS=true # true=全仓 cross，false=逐仓 isolated
