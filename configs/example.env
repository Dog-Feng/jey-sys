# 启动时会自动读取 configs/.env（可用 ENV_FILE 指定其它路径）
# 决策：MODEL=mock 不需要 JEV；MODEL=jev 必须设置 TYPESAFE_API_KEY

# Style A — mock dry-run（不调 JEV API）
EXCHANGE=mock
DRY_RUN=true
MODEL=mock
SYMBOL=BTC
TICK_INTERVAL=2s
ORDER_SIZE_BTC=0.001
MAX_POSITION_BTC=0.003
QUOTE_INSIDE_TICKS=1
HTTP_LISTEN=127.0.0.1:8080
DATA_DIR=data

# JEV（把上面 MODEL 改成 jev，并取消下面注释）
# MODEL=jev
# TYPESAFE_API_KEY=在 https://console.typesafe.ai/keys 创建（不是 Vercel 的 vck_ 密钥）
# JEV_MODEL_ID=jev-1.13.0

# Lighter RB — real book, simulated orders (DRY_RUN=true)
# 文档: https://apidocs.rh.lighter.xyz/docs/get-started  主网 Chain ID 466324
# DRY_RUN=true 时只拉盘口，不会 init 签名器、也不会调 /api/v1/apikeys
# EXCHANGE=lighter
# LIGHTER_HOST=https://api.rh.lighter.xyz
# LIGHTER_CHAIN_ID=466324
# LIGHTER_ACCOUNT_INDEX=123
# LIGHTER_API_KEY_INDEX=2
# LIGHTER_API_PRIVATE_KEY=

# Live (requires signer implementation — see README)
# DRY_RUN=false
